<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>VideoExportAudioProvider</RootNamespace>
    <AssemblyName>VideoExportAudioProvider</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">$(KK_DIR)</GameDir>
  </PropertyGroup>

  <Target Name="RequireGameDir" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(GameDir)' == '' or !Exists('$(GameDir)')">
    <Error Text="Point GameDir at your Koikatsu game folder, e.g. dotnet build -p:GameDir="C:\Games\Koikatsu" (or set the KK_DIR environment variable). BepInEx, CharaStudio and the VideoExport plugin must be installed there." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\CharaStudio_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VideoExport">
      <HintPath>$(GameDir)\BepInEx\plugins\VideoExport.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
